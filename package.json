{
  "name": "astra",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-portfolio.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/build-portfolio.mjs",
    "build": "next build",
    "start": "wrangler dev --ip 127.0.0.1 --port 3000",
    "deploy": "wrangler deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "assets:restore-game": "node scripts/restore-game-assets.mjs",
    "assets:inspect": "python scripts/inspect-portfolio-media.py"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "wrangler": "4.125.0"
  }
}
